{
  "manifest_version": 3,
  "name": "西接通勤 · 通勤找房",
  "version": "0.3.0",
  "description": "在高德地图上叠加你收录的小区；卫星影像粗判 + 通勤交给高德自己算。数据只存本机，不上传。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.amap.com/*",
    "https://*.autonavi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amap.com/*"
      ],
      "js": [
        "content/map-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.amap.com/*"
      ],
      "js": [
        "lib/logger.js",
        "lib/geo.js",
        "content/ui.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "西接通勤"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/ui.css"
      ],
      "matches": [
        "https://*.amap.com/*"
      ]
    }
  ]
}