{
  "manifest_version": 3,
  "name": "西接通勤 · 通勤找房",
  "version": "0.14.0",
  "description": "自主卫星地图：阴影聚类 + 高德小区边界(polygon)覆盖 + POI 命名。",
  "minimum_chrome_version": "111",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.amap.com/*",
    "https://*.autonavi.com/*",
    "https://overpass-api.de/*",
    "https://overpass.osm.ch/*",
    "https://restapi.amap.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amap.com/*"
      ],
      "js": [
        "content/map-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.amap.com/*"
      ],
      "js": [
        "lib/logger.js",
        "lib/geo.js",
        "content/ui.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "西接通勤"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/ui.css"
      ],
      "matches": [
        "https://*.amap.com/*"
      ]
    }
  ]
}